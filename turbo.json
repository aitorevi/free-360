{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["PGHOST", "PGPORT", "PGUSER", "PGPASSWORD", "PGDATABASE"]
    }
  }
}
